# The site's address. Point its DNS to this server before starting.
DOMAIN=portal.example.sa
# The site license (it must include DOMAIN).
LICENSE=
# Optional: keep the PDF files in S3-compatible storage instead of on this server.
# Leave S3_BUCKET empty to keep them on the server's disk with the database.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
