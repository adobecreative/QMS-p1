// =============================================================================
//  QMS-p1 — Prisma schema
//
//  This file is split into clearly marked sections. Each module PR appends its
//  own section; the FOUNDATION section is shared by every module.
//
//  Conventions (see docs/architecture.md):
//    * ids are cuid strings
//    * every module record that belongs to the quality system carries
//      `chapterCode` (+ optional `standardCode`, `departmentId`) so that chapter
//      pages and the executive dashboard can filter it automatically
//    * bilingual labels use the `...En` / `...Ar` suffix pair
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
//  FOUNDATION — organisation
// -----------------------------------------------------------------------------

enum Locale {
  ar
  en
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  nameAr       String?
  passwordHash String?
  employeeNo   String?   @unique
  jobTitle     String?
  phone        String?
  locale       Locale    @default(ar)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])

  roles                   UserRole[]
  headOfDepartments       Department[]             @relation("DepartmentHead")
  leadOfChapters          Chapter[]                @relation("ChapterLead")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]

  @@index([departmentId])
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")

  headId String?
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id])

  members   User[]     @relation("DepartmentMembers")
  userRoles UserRole[]
}

/// A role is a named bundle of permission keys (see src/core/rbac/permissions.ts).
model Role {
  id            String     @id @default(cuid())
  key           String     @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  permissions   String[]
  isSystem      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  users         UserRole[]
}

/// Assigns a role to a user, optionally scoped to one department and/or chapter.
/// No scope = the role applies hospital-wide.
model UserRole {
  id           String      @id @default(cuid())
  userId       String
  roleId       String
  departmentId String?
  chapterId    String?
  createdAt    DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, departmentId, chapterId])
  @@index([userId])
}

/// A CBAHI chapter (LD, QM, IPC, FMS ...). Chapters are the navigation of the
/// app. Adding a chapter is configuration, not code.
model Chapter {
  id            String   @id @default(cuid())
  code          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  /// Matching JCI chapter codes (e.g. ["GLD"] for LD). Suggested mapping, editable.
  jciCodes      String[]
  /// Hex colour used for the chapter tile and accents.
  color         String   @default("#0f766e")
  /// lucide-react icon name.
  icon          String   @default("BookOpen")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leadId String?
  lead   User?   @relation("ChapterLead", fields: [leadId], references: [id])

  userRoles UserRole[]
}

// -----------------------------------------------------------------------------
//  FOUNDATION — event bus (transactional outbox)
// -----------------------------------------------------------------------------

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Every meaningful change in the system is published as an event. Events are
/// written in the same transaction as the change and dispatched by the worker.
/// External systems (FMS, portal, HIS) publish here through /api/v1/events.
model DomainEvent {
  id          String      @id @default(cuid())
  type        String
  payload     Json
  /// "app" for internal events, otherwise the ApiClient name.
  source      String      @default("app")
  /// Idempotency key supplied by external systems.
  externalId  String?
  actorId     String?
  chapterCode String?
  entityType  String?
  entityId    String?
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  occurredAt  DateTime    @default(now())
  availableAt DateTime    @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([status, availableAt])
  @@index([type])
  @@index([entityType, entityId])
}

/// Bookkeeping for scheduled jobs so that only one worker instance runs a job.
model JobRun {
  name       String   @id
  lastRunAt  DateTime
  lastStatus String
  lastError  String?
}

// -----------------------------------------------------------------------------
//  FOUNDATION — notifications & alerts
// -----------------------------------------------------------------------------

enum Severity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum Channel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  /// Notification type key from src/core/notifications/catalog.ts
  type        String
  title       String
  body        String?
  link        String?
  severity    Severity  @default(INFO)
  chapterCode String?
  entityType  String?
  entityId    String?
  /// The event that caused it; together with userId+type it prevents duplicates
  /// when an event is re-dispatched.
  eventId     String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([eventId, userId, type])
  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String         @id @default(cuid())
  notificationId String
  channel        Channel
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([channel, status])
}

/// Per-user override of the default channels for one notification type.
model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// -----------------------------------------------------------------------------
//  FOUNDATION — audit trail & integrations
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  chapterCode String?
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// An external system (FMS, portal, HIS ...) allowed to call /api/v1.
model ApiClient {
  id         String    @id @default(cuid())
  name       String    @unique
  keyPrefix  String    @unique
  keyHash    String
  scopes     String[]
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}
